Evidence.square_no_all_win (a : Evidence.Assignment) : ∃ c, Evidence.loses a c = true
Evidence.square_singleton_witness (c : Fin 6) : ∃ a, ∀ (d : Fin 6), Evidence.loses a d = (d == c)
Evidence.sharp_minimum (p : Fin 6 → ℝ) (c : Fin 6) (hp : ∀ (d : Fin 6), 0 ≤ p d) (hc : ∀ (d : Fin 6), p c ≤ p d) :
  (∃ a, Evidence.failureProbability p a = p c) ∧ ∀ (a : Evidence.Assignment), p c ≤ Evidence.failureProbability p a
Evidence.success_upper_bound (p : Fin 6 → ℝ) (a : Evidence.Assignment) (β : ℝ) (hβ : 0 ≤ β)
  (hp : ∀ (c : Fin 6), β ≤ p c) (hsum : ∑ c, p c = 1) : Evidence.successProbability p a ≤ 1 - β
Evidence.defect_success_bound (β δ goodSuccess badSuccess : ℝ) (hδ0 : 0 ≤ δ) (hδ1 : δ ≤ 1) (hgood : goodSuccess ≤ 1 - β)
  (hbad : badSuccess ≤ 1) : (1 - δ) * goodSuccess + δ * badSuccess ≤ 1 - (1 - δ) * β
Evidence.ideal_observables (i : Fin 9) :
  Evidence.squareObservable i * Evidence.squareObservable i = 1 ∧
    Matrix.transpose (Evidence.squareObservable i) = Evidence.squareObservable i
Evidence.ideal_context_commutation (c : Fin 6) (i j : Fin 3) :
  Evidence.squareObservable (Evidence.contextTriple c i) * Evidence.squareObservable (Evidence.contextTriple c j) =
    Evidence.squareObservable (Evidence.contextTriple c j) * Evidence.squareObservable (Evidence.contextTriple c i)
Evidence.ideal_context_product (c : Fin 6) :
  Evidence.squareObservable (Evidence.contextTriple c 0) * Evidence.squareObservable (Evidence.contextTriple c 1) *
      Evidence.squareObservable (Evidence.contextTriple c 2) =
    if (c == 5) = true then -1 else 1
Evidence.local_factor_bound (s b A B : ℝ) (hsb : s ≤ b) (hBA : B ≤ A) (hcal : b * A + (1 - b) * B ≤ 1) :
  s * A + (1 - s) * B ≤ 1
Evidence.BetTree.finite_hitting_bound (tree : Evidence.BetTree) (h : tree.Valid) (z T : ℝ) (hz : 0 ≤ z) (hT : 0 < T) :
  tree.hitProbability z T ≤ z / T
Evidence.naive_attack_prefix_crosses : 100 < (57 / 50) ^ 36
Evidence.naive_attack_prefix_probability : 43 / 1000 < (11 / 12) ^ 36
Evidence.concrete_classical_false_positive :
  ∃ a,
    43 / 1000 <
      (Evidence.winPrefixTree 36 (Evidence.successProbability Evidence.biasedContextProbability a) (57 / 50)
            (3 / 10)).hitProbability
        1 100
Evidence.classical_square_node_valid (p : Fin 6 → ℝ) (a : Evidence.Assignment) (β A B : ℝ) (win lose : Evidence.BetTree)
  (hβ : 0 ≤ β) (hp : ∀ (c : Fin 6), β ≤ p c) (hsum : ∑ c, p c = 1) (hB : 0 ≤ B) (hBA : B ≤ A)
  (hcal : (1 - β) * A + β * B ≤ 1) (hw : win.Valid) (hl : lose.Valid) :
  (Evidence.BetTree.node (Evidence.successProbability p a) A B win lose).Valid
